{
  "name": "@clank.run/framework",
  "version": "0.13.0",
  "description": "AI-first, zero-dependency full-stack TypeScript framework with SSR, live data, auth, durable jobs, cron, and deployment.",
  "homepage": "https://docs.clank.run",
  "bugs": {
    "url": "https://github.com/nearbycoder/clank.run/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearbycoder/clank.run.git"
  },
  "author": {
    "name": "Clank contributors",
    "url": "https://github.com/nearbycoder/clank.run/graphs/contributors"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./dom": { "types": "./dist/dom.d.ts", "import": "./dist/dom.js" },
    "./router": { "types": "./dist/router.d.ts", "import": "./dist/router.js" },
    "./ai": { "types": "./dist/ai.d.ts", "import": "./dist/ai.js" },
    "./agent-contract": { "types": "./dist/agent-contract.d.ts", "import": "./dist/agent-contract.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" },
    "./blueprint": { "types": "./dist/blueprint.d.ts", "import": "./dist/blueprint.js" },
    "./webauthn": { "types": "./dist/webauthn.d.ts", "import": "./dist/webauthn.js" },
    "./services": { "types": "./dist/services.d.ts", "import": "./dist/services.js" },
    "./object-storage": { "types": "./dist/object-storage.d.ts", "import": "./dist/object-storage.js" },
    "./observability": { "types": "./dist/observability.d.ts", "import": "./dist/observability.js" },
    "./recovery": { "types": "./dist/recovery.d.ts", "import": "./dist/recovery.js" },
    "./orchestration": { "types": "./dist/orchestration.d.ts", "import": "./dist/orchestration.js" },
    "./runner": { "types": "./dist/runner.d.ts", "import": "./dist/runner.js" },
    "./provider": { "types": "./dist/provider.d.ts", "import": "./dist/provider.js" },
    "./runtime-placement": { "types": "./dist/runtime-placement.d.ts", "import": "./dist/runtime-placement.js" },
    "./provider-data": { "types": "./dist/provider-data.d.ts", "import": "./dist/provider-data.js" },
    "./provider-runtime": { "types": "./dist/provider-runtime.d.ts", "import": "./dist/provider-runtime.js" },
    "./provider-docker": { "types": "./dist/provider-docker.d.ts", "import": "./dist/provider-docker.js" },
    "./provider-service": { "types": "./dist/provider-service.d.ts", "import": "./dist/provider-service.js" },
    "./data-plane": { "types": "./dist/data-plane.d.ts", "import": "./dist/data-plane.js" },
    "./forms": { "types": "./dist/forms.d.ts", "import": "./dist/forms.js" },
    "./ui": { "types": "./dist/ui.d.ts", "import": "./dist/ui.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./auth": { "types": "./dist/auth.d.ts", "import": "./dist/auth.js" },
    "./backend": { "types": "./dist/backend.d.ts", "import": "./dist/backend.js" },
    "./deploy": { "types": "./dist/deploy.d.ts", "import": "./dist/deploy.js" },
    "./migrations": { "types": "./dist/migrations.d.ts", "import": "./dist/migrations.js" },
    "./jobs": { "types": "./dist/jobs.d.ts", "import": "./dist/jobs.js" },
    "./journey": { "types": "./dist/journey.d.ts", "import": "./dist/journey.js" },
    "./collaboration": { "types": "./dist/collaboration.d.ts", "import": "./dist/collaboration.js" },
    "./analytics": { "types": "./dist/analytics.d.ts", "import": "./dist/analytics.js" },
    "./billing": { "types": "./dist/billing.d.ts", "import": "./dist/billing.js" },
    "./platform": { "types": "./dist/platform.d.ts", "import": "./dist/platform.js" },
    "./ssr": { "types": "./dist/ssr.d.ts", "import": "./dist/ssr.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" },
    "./compiler": {
      "types": "./scripts/compiler.d.mts",
      "import": "./scripts/compiler.mjs"
    }
  },
  "bin": {
    "clank": "scripts/clank.mjs",
    "clank-platform": "scripts/clank-platform.mjs",
    "clank-runner": "scripts/clank-runner.mjs",
    "clank-provider": "scripts/clank-provider.mjs"
  },
  "files": [
    "brand",
    "dist",
    "examples",
    "!examples/**/*.js",
    "!examples/**/*.sqlite",
    "!examples/**/*.sqlite-shm",
    "!examples/**/*.sqlite-wal",
    "scripts/compiler.mjs",
    "scripts/compiler.d.mts",
    "scripts/clank.mjs",
    "scripts/clank-dev.mjs",
    "scripts/cli-deploy.mjs",
    "scripts/cli-compose.mjs",
    "scripts/cli-journey.mjs",
    "scripts/clank-platform.mjs",
    "scripts/clank-runner.mjs",
    "scripts/clank-provider.mjs",
    "scripts/platform-hosting.mjs",
    "scripts/platform-billing.mjs",
    "scripts/conformance.mjs",
    "scripts/tsx.mjs",
    "templates",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "build:docs": "node --disable-warning=ExperimentalWarning docs-site/build.mjs",
    "conformance": "node --disable-warning=ExperimentalWarning scripts/conformance.mjs",
    "docs:audit": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning docs-site/build.mjs && node --disable-warning=ExperimentalWarning scripts/docs-audit.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "dev:fullstack": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning examples/fullstack/server.js",
    "dev:auth": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning examples/auth-todo/server.js",
    "dev:platform": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning scripts/clank-platform.mjs",
    "test": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node --disable-warning=ExperimentalWarning docs-site/build.mjs && node --disable-warning=ExperimentalWarning --test",
    "security:audit": "node --disable-warning=ExperimentalWarning scripts/security-audit.mjs",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "reactive",
    "framework",
    "typescript",
    "ai",
    "agents",
    "mcp",
    "oauth",
    "ssr",
    "sqlite",
    "realtime",
    "jobs",
    "queue",
    "cron",
    "deployment",
    "platform",
    "fine-grained",
    "jsx",
    "developer-tools"
  ],
  "packageManager": "npm@11.18.0"
}
