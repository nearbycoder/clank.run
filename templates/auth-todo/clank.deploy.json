{
  "version": 1,
  "entry": "dist/server.js",
  "include": [
    "dist",
    "migrations"
  ],
  "build": {
    "command": [
      "clank",
      "build",
      "src",
      "dist",
      "--tailwind=src/styles.css"
    ]
  },
  "database": {
    "path": "app.sqlite",
    "migrations": "migrations",
    "allowUnsafeMigrations": false,
    "previewData": {
      "tables": {
        "clank_todos": {
          "rows": 500,
          "columns": {
            "_id": "keep",
            "_owner_id": "hash",
            "_creation_time": "keep",
            "_version": "keep",
            "_data": {
              "json": {
                "default": "hash",
                "paths": {
                  "/done": "keep"
                }
              }
            }
          }
        }
      }
    }
  },
  "health": {
    "path": "/healthz",
    "timeoutMs": 15000
  },
  "env": {},
  "jobs": {
    "entry": "dist/jobs.js",
    "workers": 1,
    "concurrency": 2,
    "queues": [],
    "scheduler": true
  }
}
